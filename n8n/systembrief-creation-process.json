      "parameters": {
        "jsCode": "function parseResult(item) {\n  const stdout = item.stdout || '';\n  const line = String(stdout).split(/\\r?\\n/).reverse().find(l => l.startsWith('N8N_RESULT=')) || '';\n  if (!line) {\n    return {\n      ok: Number(item.exitCode) === 0,\n      reason: 'no_n8n_result',\n      exitCode: item.exitCode,\n      stderr: (item.stderr || '').slice(-2000),\n      stdout: String(stdout).slice(-4000)\n    };\n  }\n  return JSON.parse(line.slice('N8N_RESULT='.length));\n}\nreturn [{ json: parseResult($input.first().json || {}) }];"
      },
