{
  "name": "Systembrief — Topic Ingest",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Topic Ingest\n\nAlle 2 Stunden: Queue aus konfigurierten Quellen füllen (`n8n-pipeline.ps1 -Action ingest`).\n\nSelf-hosted n8n auf dem Studio-Rechner.\nKeine Produktnamen in öffentlichen Texten — das Ingest-Skript mappt nur intern.\n\nEnv: `SYSTEMBRIEF_PIPELINE_ROOT`, optional Notify.",
        "height": 300,
        "width": 360,
        "color": 6
      },
      "id": "note-ingest",
      "name": "Hinweis",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [80, 180]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "hours",
              "hoursInterval": 2
            }
          ]
        }
      },
      "id": "sched-ingest",
      "name": "Alle 2 Stunden",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [500, 200]
    },
    {
      "parameters": {},
      "id": "manual-ingest",
      "name": "Manuell",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [500, 400]
    },
    {
      "parameters": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { if (-not $env:SYSTEMBRIEF_PIPELINE_ROOT) { throw 'SYSTEMBRIEF_PIPELINE_ROOT is not set' }; & (Join-Path $env:SYSTEMBRIEF_PIPELINE_ROOT 'scripts\\n8n-pipeline.ps1') -Action ingest -Count 8 }\"",
        "executeOnce": true
      },
      "id": "exec-ingest",
      "name": "Pipeline ingest",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [760, 300],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "function parseResult(item) {\n  const stdout = item.stdout || '';\n  const line = String(stdout).split(/\\r?\\n/).reverse().find(l => l.startsWith('N8N_RESULT=')) || '';\n  if (!line) {\n    return { ok: false, reason: 'no_n8n_result', exitCode: item.exitCode, stderr: item.stderr, stdout: String(stdout).slice(-4000) };\n  }\n  return JSON.parse(line.slice('N8N_RESULT='.length));\n}\nreturn [{ json: parseResult($input.first().json || {}) }];"
      },
      "id": "code-parse-ingest",
      "name": "Ergebnis parsen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 300]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-notify",
              "leftValue": "={{ $env.SYSTEMBRIEF_NOTIFY_WEBHOOK }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-notify-ingest",
      "name": "Notify gesetzt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1240, 300]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SYSTEMBRIEF_NOTIFY_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: ($json.ok ? 'Systembrief ingest ok' : 'Systembrief ingest fehlgeschlagen'), report: { ok: $json.ok, action: $json.action, error: $json.error } }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "http-notify-ingest",
      "name": "Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1480, 200]
    }
  ],
  "connections": {
    "Alle 2 Stunden": {
      "main": [[{ "node": "Pipeline ingest", "type": "main", "index": 0 }]]
    },
    "Manuell": {
      "main": [[{ "node": "Pipeline ingest", "type": "main", "index": 0 }]]
    },
    "Pipeline ingest": {
