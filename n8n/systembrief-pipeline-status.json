{
  "name": "Systembrief — Pipeline Status",
  "active": false,
  "nodes": [
    {
      "parameters": {
        "content": "## Pipeline Status\n\nTäglich 08:30 Berlin + manuell + Webhook `GET/POST /webhook/systembrief-status`.\n\nLiefert Queue (content / upload / full), fällige Releases und Site-Health.\nSelf-hosted n8n (Execute Command).",
        "height": 280,
        "width": 360,
        "color": 3
      },
      "id": "note-status",
      "name": "Hinweis",
      "type": "n8n-nodes-base.stickyNote",
      "typeVersion": 1,
      "position": [80, 180]
    },
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "30 8 * * *"
            }
          ]
        }
      },
      "id": "sched-status",
      "name": "08:30 Berlin",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [500, 140]
    },
    {
      "parameters": {},
      "id": "manual-status",
      "name": "Manuell",
      "type": "n8n-nodes-base.manualTrigger",
      "typeVersion": 1,
      "position": [500, 320]
    },
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "systembrief-status",
        "responseMode": "lastNode",
        "options": {}
      },
      "id": "hook-status",
      "name": "Webhook Status",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [500, 500],
      "webhookId": "systembrief-status"
    },
    {
      "parameters": {
        "command": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"& { if (-not $env:SYSTEMBRIEF_PIPELINE_ROOT) { throw 'SYSTEMBRIEF_PIPELINE_ROOT is not set' }; & (Join-Path $env:SYSTEMBRIEF_PIPELINE_ROOT 'scripts\\n8n-pipeline.ps1') -Action status -Count 8 }\"",
        "executeOnce": true
      },
      "id": "exec-status",
      "name": "Pipeline status",
      "type": "n8n-nodes-base.executeCommand",
      "typeVersion": 1,
      "position": [760, 320],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "function parseResult(item) {\n  const stdout = item.stdout || '';\n  const line = String(stdout).split(/\\r?\\n/).reverse().find(l => l.startsWith('N8N_RESULT=')) || '';\n  if (!line) {\n    return { ok: false, reason: 'no_n8n_result', exitCode: item.exitCode, stderr: item.stderr, stdout: String(stdout).slice(-4000) };\n  }\n  return JSON.parse(line.slice('N8N_RESULT='.length));\n}\nreturn [{ json: parseResult($input.first().json || {}) }];"
      },
      "id": "code-parse-status",
      "name": "Ergebnis parsen",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1000, 320]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 2
          },
          "conditions": [
            {
              "id": "has-notify",
              "leftValue": "={{ $env.SYSTEMBRIEF_NOTIFY_WEBHOOK }}",
              "rightValue": "",
              "operator": {
                "type": "string",
                "operation": "notEmpty"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "if-notify-status",
      "name": "Notify gesetzt?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [1240, 320]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $env.SYSTEMBRIEF_NOTIFY_WEBHOOK }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ text: 'Systembrief Status: due=' + (($json.due_today || []).length) + ' content=' + (($json.next_content || []).length) + ' upload=' + (($json.next_upload || []).length) + ' site=' + (($json.health && $json.health.ok) ? 'ok' : 'fail'), report: $json }) }}",
        "options": {
          "response": {
            "response": {
              "neverError": true,
              "responseFormat": "text"
            }
          }
        }
      },
      "id": "http-notify-status",
      "name": "Notify",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.2,
      "position": [1480, 220]
    }
  ],
